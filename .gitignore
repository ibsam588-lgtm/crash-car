# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.flutter-plugins
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/key.properties
/android/app/*.jks
/android/app/*.keystore

# Unity generated state and builds
/unity/**/[Ll]ibrary/
/unity/**/[Tt]emp/
/unity/**/[Oo]bj/
/unity/**/[Ll]ogs/
/unity/**/[Uu]serSettings/
/unity/**/[Bb]uilds/
/unity/**/.vs/
*.blend1
*.blend1.meta

# Signing material and generated CI credentials (never publish)
/.private/
/unity/**/.ci/
*.jks
*.keystore
*.p12
*-service-account.json

# Local development output
tmp_http_*.out.log
tmp_http_*.err.log
unity_*_stdout.log
unity_*_install.out.log
unity_*_install.err.log
